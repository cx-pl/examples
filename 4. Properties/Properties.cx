import System;

public class Counter {
    int storedValue;

    public constructor() {}

    public int Value {
        get { return storedValue; }
        set { storedValue = value; }
    }
}

public int Main() {
    Counter counter = new Counter();
    counter.Value = 37;
    if (counter.Value != 37) return 1;
    Console.WriteLine("properties pass");
    return 0;
}
