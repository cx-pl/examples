import System;

concept CEquatable {
	bool operator ==(const CEquatable other) const;
}

concept CComparable {
	bool operator >(const CEquatable other) const;
}

public class Address {
	public string City { const get; set; }
	public string Street { const get; set; }
	public int BuildingNumber { const get; set; }
	
	public bool operator ==(const CEquatable other) const {
		return City == other.City && Street == other.Street && BuildingNumber == other.BuildingNumber;
	}
	
	public bool operator >(const CEquatable other) const {
		return City > other.City || Street > other.Street || BuildingNumber > other.BuildingNumber;
	}
}

public static class Utils {
	public static T Max<T>(T a, T b)
		: T = CEquatable, CComparable {
		return (a > b) ? a : b;
	}
}

public int Main() {
	return 0;
}
