import System;

public class ExpressionExamples {
    public static int Calculate(int left, int right) {
        int arithmetic = left + right * 2;
        int flags = left << 1 | right;
        return arithmetic > flags ? arithmetic : flags;
    }

    public static string DisplayName(string preferredName, string fallbackName) {
        return preferredName ?? fallbackName;
    }
}

public int Main() {
    if (ExpressionExamples.Calculate(3, 4) != 11) return 1;
    if (ExpressionExamples.DisplayName(null, "fallback") != "fallback") return 1;
    Console.WriteLine("expressions pass");
    return 0;
}
