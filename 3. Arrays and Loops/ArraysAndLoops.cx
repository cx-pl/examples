import System;

public int SumSmallSquares() {
    int[] squares = new int[5];

    for (int index = 0; index < 5; index++) {
        squares[index] = index * index;
    }

    int total = 0;
    foreach (int square in squares) {
        if (square > 9) {
            break;
        }
        total += square;
    }

    return total;
}

public int Main() {
    if (SumSmallSquares() != 14) return 1;
    Console.WriteLine("arrays pass");
    return 0;
}
